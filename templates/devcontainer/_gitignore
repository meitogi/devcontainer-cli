# DevContainer (v2) — internals scoped to .devcontainer/

# Runtime artefacts (auto-generated, per-rebuild)
.env
.configured-*
logs/

# Skill scratch dirs (keep dir via .keep, ignore content)
pending/*
pr-drafts/*
research-bundles/*
scan-deps/*

!pending/.keep
!pr-drafts/.keep
!research-bundles/.keep
!scan-deps/.keep

# Python bytecode cache — anywhere under .devcontainer/
**/__pycache__/

# Firewall — local overrides, caches, test logs
firewall/domains.local.txt
firewall/policy.local.d/*
firewall/tests/*.log
firewall-blocks.*.log
# Build output of firewall-docker-setup.sh, never a source. Committing it would
# put a hand-editable copy of the compiled ruleset next to the files it is
# supposed to be derived from.
firewall/effective/
firewall/baked-at

!firewall/policy.local.d/.keep

# Skills — local personal variants
skills/**/*.local.skill.md
skills/**/*.local/

# claude-bridge sidecar runtime config (bootstrapped from .example.json)
claude-bridge/config.json

# Notify daemon — runtime artefacts under notify/queue/ (auto-generated)
#   *.jsonl          : per-hook event queue (consumed + cleaned by the daemon)
#   daemon.log       : daemon stderr/stdout sink (rotated at 1 MB → 100 KB)
#   .daemon.pid      : single-instance lockfile + heartbeat (mtime touched every 10 s)
#   .daemon.startup* : channel readback dropped after init (also covers the .tmp
#                      sibling that survives a writeFileSync→renameSync crash window)
#   state/           : pending.json + actions.jsonl (in-flight timers + audit
#                      log, both reset per daemon lifetime — see lib/state.js)
notify/queue/*.jsonl
notify/queue/daemon.log
notify/queue/.daemon.pid
notify/queue/.daemon.startup*
notify/queue/state/

# Lessons — local / not-yet-generalisable (committed sibling is LESSONS.md)
LESSONS.local.md

# Per-dev zsh override + custom OMZ plugins/themes (paths from .devcontainer/)
zshrc.local
.zsh-custom/

tmp/
# Caches — fetched or derived, never committed. In particular
# cache/ext-patchs/<ref>/ holds patchers the 45-ext-patches hook fetched from
# a private repository: committing them would republish exactly what moving
# them out of this tree was meant to stop.
cache/
