# DevContainer (v3) — internals scoped to .devcontainer/

# Everything a machine writes lives under tmp/ : the patcher cache
# (cache/ext-patchs/<ref>/), the notify queue and its .authority, the lifecycle
# logs and the setup markers, and watch-log's host hand-off (tmp/pending/, which
# the image purges past 60 min anyway). Nothing under it is a source — `rm -rf
# tmp/` costs only a refetch of the patchers from the private repository, which
# is exactly what moving them out of this tree was meant to keep out of git.
tmp/

# Secrets and per-dev overrides — hand-edited, never generated
.env

# prepare-pr's output: authored documents you copy into `gh pr create`, and
# nothing purges them — which is why this one stays out of tmp/, whose whole
# promise is that deleting it costs nothing. watch-log's pending/ went the other
# way, under tmp/, because the image purges it. research-bundles/ and scan-deps/
# left with their skills: no baked skill references either any more.
pr-drafts/*

!pr-drafts/.keep

# Python bytecode cache — anywhere under .devcontainer/
**/__pycache__/

# Firewall — local overrides, caches, test logs
firewall/domains.local.txt
firewall/policy.local.d/*
firewall/tests/*.log
firewall-blocks.*.log
# Build output of firewall-docker-setup.sh, never a source. Committing it would
# put a hand-editable copy of the compiled ruleset next to the files it is
# supposed to be derived from.
firewall/effective/
firewall/baked-at

!firewall/policy.local.d/.keep

# Skills — local personal variants
skills/**/*.local.skill.md
skills/**/*.local/

# claude-bridge sidecar runtime config (bootstrapped from .example.json)
claude-bridge/config.json

# Lessons — local / not-yet-generalisable (committed sibling is LESSONS.md)
LESSONS.local.md

# Per-dev zsh override + custom OMZ plugins/themes (paths from .devcontainer/)
zshrc.local
.zsh-custom/
